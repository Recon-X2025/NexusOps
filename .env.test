DATABASE_URL=postgresql://coheronconnect_test:coheronconnect_test@localhost:5433/coheronconnect_test
REDIS_URL=redis://localhost:6380
MEILISEARCH_URL=http://localhost:7701
MEILISEARCH_KEY=test_master_key
AUTH_SECRET=test-secret-do-not-use-in-production-abcdef123456
ENCRYPTION_KEY=test-encryption-key-32-chars-long!
# AES-256 KEK for services/encryption.ts (encryptSecret) — the TOTP MFA enroll
# flow and integration-credential wrapping read it via kek() in services/kms.ts.
# Same literal as ci.yml so a local run and CI agree; without it the Director KYC
# spec fails locally on "APP_SECRET is not configured" while passing in CI.
APP_SECRET=test-app-secret-32-chars-minimum-here
# Pepper for HMAC of government identifiers (Aadhaar/PAN). Test-only value.
PII_HASH_PEPPER=test-pii-pepper-do-not-use-in-production-0123456789abcdef
NEXT_PUBLIC_API_URL=http://localhost:3001
NODE_ENV=test
# Allow many logins per minute so auth tests never hit the rate limiter
LOGIN_RATE_PER_MIN=1000
# Signup is exercised by e2e/auth.spec.ts and the signup router tests.
SIGNUP_ENABLED=true
